# Every container's output to CloudWatch Logs, one stream per pod, with the pod's labels. The JSON
# the Niadra processes print is merged into fields, so Logs Insights can filter on `level`.
config:
  inputs: |
    [INPUT]
        Name tail
        Path /var/log/containers/*.log
        multiline.parser cri
        Tag kube.*
        Mem_Buf_Limit 20MB
        Skip_Long_Lines On
  filters: |
    [FILTER]
        Name kubernetes
        Match kube.*
        Merge_Log On
        Keep_Log Off
        Labels On
        Annotations Off
  outputs: |
    [OUTPUT]
        Name cloudwatch_logs
        Match kube.*
        region {{ requiredEnv "NIADRA_REGION" }}
        log_group_name {{ env "NIADRA_LOG_GROUP" | default "/niadra/cluster" }}
        log_stream_template $kubernetes['namespace_name'].$kubernetes['pod_name']
        log_stream_prefix pod.
        auto_create_group Off
# 14 MiB of working set on 25/09/2026, peak 32; the input buffers up to 20 MB while CloudWatch lags.
resources:
  requests: {cpu: 50m, memory: 32Mi}
  limits: {memory: 192Mi}
tolerations: [{operator: Exists}]
