    "UserData": {
     "Fn::Base64": "#!/bin/bash\nset -euxo pipefail\nexport DEBIAN_FRONTEND=noninteractive\n# The subnet gives no automatic public address: the machine reaches the internet once the\n# fixed address is attached, a few seconds after launch.\nip() { curl -s -H \"X-aws-ec2-metadata-token: $(curl -s -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60')\" http://169.254.169.254/latest/meta-data/public-ipv4; }\nuntil [ \"$(ip)\" = \"${Address}\" ]; do sleep 5; done\napt-get update -y && apt-get install -y jq curl unzip\nsnap install aws-cli --classic\n# --cluster-init starts embedded etcd, so more servers can join later without a rebuild.\ncurl -sfL https://get.k3s.io | INSTALL_K3S_VERSION='v1.33.13+k3s2' \\\n  sh -s - server --cluster-init --secrets-encryption --write-kubeconfig-mode 0600\n# The machine also builds the images and runs the deploy: Docker, Helm and helmfile.\napt-get install -y docker.io && systemctl enable --now docker\ncurl -fsSL https://get.helm.sh/helm-v4.3.0-linux-amd64.tar.gz | tar -xz -C /usr/local/bin --strip-components=1 linux-amd64/helm\ncurl -fsSL https://github.com/helmfile/helmfile/releases/download/v1.8.0/helmfile_1.8.0_linux_amd64.tar.gz | tar -xz -C /usr/local/bin helmfile\nHOME=/root helm plugin install https://github.com/databus23/helm-diff --verify=false || true\n# The ingress controller k3s ships, with access logs as JSON (they go to CloudWatch). The\n# Local policy keeps the client's address on the way in (the contact form limits by it).\ncat > /var/lib/rancher/k3s/server/manifests/traefik-config.yaml <<'EOF'\napiVersion: helm.cattle.io/v1\nkind: HelmChartConfig\nmetadata: {name: traefik, namespace: kube-system}\nspec:\n  valuesContent: |-\n    service:\n      spec: {externalTrafficPolicy: Local}\n    logs:\n      access: {enabled: true, format: json}\nEOF\n# ECR tokens last 12 hours: every 6 hours the pods' default service account in the\n# niadra namespace gets a fresh pull secret, made with this machine's role.\ncat > /usr/local/bin/niadra-ecr-login <<'EOF'\n#!/bin/bash\nset -euo pipefail\nkubectl create namespace niadra --dry-run=client -o yaml | kubectl apply -f -\nkubectl -n niadra create secret docker-registry ecr \\\n  --docker-server=111122223333.dkr.ecr.us-east-2.amazonaws.com --docker-username=AWS \\\n  --docker-password=\"$(/snap/bin/aws ecr get-login-password --region us-east-2)\" \\\n  --dry-run=client -o yaml | kubectl apply -f -\nkubectl -n niadra patch serviceaccount default -p '{\"imagePullSecrets\":[{\"name\":\"ecr\"}]}'\nEOF\nchmod 755 /usr/local/bin/niadra-ecr-login\ncat > /etc/systemd/system/niadra-ecr-login.service <<'EOF'\n[Service]\nType=oneshot\nEnvironment=KUBECONFIG=/etc/rancher/k3s/k3s.yaml\nExecStart=/usr/local/bin/niadra-ecr-login\nEOF\ncat > /etc/systemd/system/niadra-ecr-login.timer <<'EOF'\n[Timer]\nOnBootSec=2min\nOnUnitActiveSec=6h\n[Install]\nWantedBy=timers.target\nEOF\nsystemctl daemon-reload && systemctl enable --now niadra-ecr-login.timer\n"
    }
   },
   "Type": "AWS::EC2::Instance"
  },
