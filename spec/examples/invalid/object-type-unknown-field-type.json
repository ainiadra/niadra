{
  "type": "cotacao_plano_saude",
  "ownership": "subject",
  "nature": "derived",
  "mirror_of": {
    "system": "api_da_operadora",
    "derived_by": "declaration",
    "drift": "alert"
  },
  "inputs": [
    "lead.city",
    "lead.state",
    "lead.ages",
    "lead.household",
    "turn.product_type",
    "campaign.discount_validity"
  ],
  "fields": {
    "price_full": {
      "type": "decimal",
      "role": "price_full",
      "claim": {
        "allowed": true,
        "class": "money",
        "nature": "computed"
      }
    },
    "price_discounted": {
      "type": "money",
      "role": "price_discounted",
      "claim": {
        "allowed": true,
        "class": "money",
        "nature": "computed"
      }
    },
    "price_health_part": {
      "type": "money",
      "role": "health_share",
      "claim": {
        "allowed": false
      }
    },
    "price_health_only": {
      "type": "money",
      "role": "price_health_only",
      "claim": {
        "allowed": true,
        "class": "money",
        "nature": "computed"
      }
    },
    "enrollment_fee": {
      "type": "money",
      "logic": "tri",
      "role": "enrollment_fee",
      "unobserved_blocks": [
        "decide:close"
      ],
      "claim": {
        "allowed": true,
        "class": "money",
        "nature": "computed"
      }
    }
  },
  "sources": {
    "quote_api": {
      "kind": "pull",
      "precedence": 1,
      "known_defects": [
        {
          "field": "enrollment_fee",
          "use_source": "budget_document"
        }
      ]
    },
    "curated_table": {
      "kind": "batch",
      "precedence": 2,
      "active_when": "config.discount_source == 'table'",
      "empty_means": "absent"
    },
    "budget_document": {
      "kind": "pull",
      "precedence": 1,
      "authoritative_for": [
        "enrollment_fee"
      ]
    }
  },
  "union": {
    "*": "first_by_precedence"
  },
  "refetch": {
    "reasons": [
      {
        "name": "input_changed",
        "when": "derived_status == 'expired_by_input'",
        "priority": "high",
        "budget": {
          "units": "unlimited"
        }
      },
      {
        "name": "time_expired",
        "when": "age(price_full) > 72h",
        "budget": {
          "units": 1,
          "per": "session"
        }
      },
      {
        "name": "discount_expired",
        "when": "changed(campaign.discount_validity)",
        "budget": {
          "units": 1,
          "per": "day"
        }
      }
    ],
    "never": [
      "no_news"
    ],
    "budget": {
      "unit": "quote_call",
      "never_money": true
    }
  },
  "purposes": {
    "display": {
      "on_stale": "serve_with_age"
    },
    "claim": {
      "on_stale": "serve_with_prohibitions",
      "prohibitions": [
        "affirm_price"
      ]
    },
    "decide": {
      "on_stale": "structured_refusal",
      "reason": "stale_quote",
      "action": "requote"
    }
  },
  "readings": {
    "commercial": {
      "fields": [
        "price_full",
        "price_discounted"
      ],
      "purposes": [
        "sales"
      ]
    },
    "closing": {
      "fields": [
        "enrollment_fee",
        "price_discounted"
      ],
      "prefer_source": "budget_document",
      "purposes": [
        "closing"
      ]
    },
    "audit": {
      "fields": [
        "*"
      ],
      "include_inputs": true,
      "purposes": [
        "audit"
      ]
    }
  },
  "retention": {
    "projection": "30d"
  }
}
