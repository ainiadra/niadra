{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.niadra.com/schemas/object-type.v0.json",
  "title": "Niadra Object Type v0",
  "description": "One object type of a company's type registry: fields, sources, freshness, lifecycle, timers, readings and relations, declared or derived from the company's schema. See spec/object-type.md.",
  "$defs": {
    "AccessRule": {
      "additionalProperties": false,
      "properties": {
        "readers": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,63}$",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Readers",
          "type": "array"
        },
        "purposes": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,63}$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Purposes",
          "type": "array"
        },
        "effect": {
          "enum": [
            "allow",
            "mask",
            "deny"
          ],
          "title": "Effect",
          "type": "string"
        }
      },
      "required": [
        "readers",
        "effect"
      ],
      "title": "AccessRule",
      "type": "object"
    },
    "AgentStatePolicy": {
      "additionalProperties": false,
      "description": "How an agent's working state of a type is scoped and written. A state is kept whole, with no cap: a write is bounded only by the request's own size limit, and refused there.",
      "properties": {
        "scope": {
          "default": "conversation",
          "enum": [
            "conversation",
            "task",
            "object",
            "subject"
          ],
          "title": "Scope",
          "type": "string"
        },
        "write": {
          "default": "both",
          "description": "The write modes allowed.",
          "enum": [
            "cas",
            "merge_by_key",
            "both"
          ],
          "title": "Write",
          "type": "string"
        }
      },
      "title": "AgentStatePolicy",
      "type": "object"
    },
    "Attribute": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,63}$",
          "title": "Family",
          "type": "string"
        },
        "vocabulary": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.:-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vocabulary"
        }
      },
      "required": [
        "family"
      ],
      "title": "Attribute",
      "type": "object"
    },
    "Axis": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "enum": [
            "source",
            "derived",
            "platform"
          ],
          "title": "Origin",
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{0,63}@[A-Za-z0-9_.-]{1,32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "immutable": {
          "default": false,
          "title": "Immutable",
          "type": "boolean"
        }
      },
      "required": [
        "origin"
      ],
      "title": "Axis",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "units": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "const": "unlimited",
              "type": "string"
            }
          ],
          "title": "Units"
        },
        "per": {
          "anyOf": [
            {
              "pattern": "^(item|object|turn|session|conversation|subject|space|day)(/[0-9]{1,6}(ms|s|min|h|d))?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The scope and period the units count in, `item/1h`.",
          "title": "Per"
        }
      },
      "required": [
        "units"
      ],
      "title": "Budget",
      "type": "object"
    },
    "ClaimPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "title": "Allowed",
          "type": "boolean"
        },
        "class": {
          "anyOf": [
            {
              "enum": [
                "money",
                "percent",
                "date",
                "quantity",
                "count",
                "duration",
                "dosage",
                "text"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Class"
        },
        "nature": {
          "anyOf": [
            {
              "enum": [
                "computed",
                "quoted",
                "observed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nature"
        }
      },
      "required": [
        "allowed"
      ],
      "title": "ClaimPolicy",
      "type": "object"
    },
    "ClaimPurpose": {
      "additionalProperties": false,
      "properties": {
        "on_stale": {
          "const": "serve_with_prohibitions",
          "default": "serve_with_prohibitions",
          "title": "On Stale",
          "type": "string"
        },
        "prohibitions": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Prohibitions",
          "type": "array"
        }
      },
      "title": "ClaimPurpose",
      "type": "object"
    },
    "Completeness": {
      "additionalProperties": false,
      "properties": {
        "levels": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z][a-z0-9_.:-]{0,63}$",
                "type": "string"
              },
              "maxItems": 8,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Levels"
        },
        "total_field": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Field"
        }
      },
      "title": "Completeness",
      "type": "object"
    },
    "ContentPolicy": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "full",
          "enum": [
            "full",
            "pointer",
            "hash_only"
          ],
          "title": "Mode",
          "type": "string"
        },
        "scan": {
          "default": "rules",
          "enum": [
            "required",
            "rules",
            "off"
          ],
          "title": "Scan",
          "type": "string"
        },
        "fields": {
          "description": "The fields holding content.",
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Fields",
          "type": "array"
        }
      },
      "title": "ContentPolicy",
      "type": "object"
    },
    "DecidePurpose": {
      "additionalProperties": false,
      "properties": {
        "on_stale": {
          "default": "serve_with_age",
          "enum": [
            "serve_with_age",
            "structured_refusal"
          ],
          "title": "On Stale",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.:-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "action": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.:-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        }
      },
      "title": "DecidePurpose",
      "type": "object"
    },
    "DerivedField": {
      "additionalProperties": false,
      "description": "A field computed when the object is read, from the related objects of one relation (a look's pieces): never stored, so it follows every change of a related object at once.",
      "properties": {
        "agg": {
          "enum": [
            "min",
            "max",
            "count",
            "all",
            "any"
          ],
          "title": "Agg",
          "type": "string"
        },
        "over": {
          "description": "The relation whose related objects it is computed over.",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Over",
          "type": "string"
        },
        "where": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A condition on each related object, in its own type's terms: `count` counts the ones it holds for, `all` and `any` say whether it holds for every one or for some, and `min` and `max` compare only those.",
          "title": "Where"
        },
        "field": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The related objects' field `min` and `max` compare; only they name one.",
          "title": "Field"
        }
      },
      "required": [
        "agg",
        "over"
      ],
      "title": "DerivedField",
      "type": "object"
    },
    "DisplayPurpose": {
      "additionalProperties": false,
      "properties": {
        "on_stale": {
          "const": "serve_with_age",
          "default": "serve_with_age",
          "title": "On Stale",
          "type": "string"
        }
      },
      "title": "DisplayPurpose",
      "type": "object"
    },
    "ExpiredWithoutOutcome": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "pattern": "^[0-9]{1,6}(ms|s|min|h|d)$",
              "type": "string"
            },
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            }
          ],
          "description": "A duration, or the name of a value holding the deadline.",
          "title": "After"
        }
      },
      "required": [
        "after"
      ],
      "title": "ExpiredWithoutOutcome",
      "type": "object"
    },
    "FieldFreshness": {
      "additionalProperties": false,
      "properties": {
        "class": {
          "$ref": "#/$defs/FreshnessClass"
        },
        "max_age": {
          "anyOf": [
            {
              "pattern": "^[0-9]{1,6}(ms|s|min|h|d)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Age"
        },
        "claim_max_age": {
          "anyOf": [
            {
              "pattern": "^[0-9]{1,6}(ms|s|min|h|d)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Max Age"
        }
      },
      "required": [
        "class"
      ],
      "title": "FieldFreshness",
      "type": "object"
    },
    "FieldSpec": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "string",
            "text",
            "number",
            "money",
            "percent",
            "date",
            "datetime",
            "duration",
            "bool",
            "enum",
            "list",
            "ref"
          ],
          "title": "Type",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 60,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The field's name in the space's language, as a text for a model says it (`coparticipação`); the field's own name otherwise.",
          "title": "Label"
        },
        "logic": {
          "default": "plain",
          "enum": [
            "plain",
            "tri"
          ],
          "title": "Logic",
          "type": "string"
        },
        "observers": {
          "items": {
            "$ref": "#/$defs/Observer"
          },
          "maxItems": 8,
          "title": "Observers",
          "type": "array"
        },
        "unobserved_blocks": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Unobserved Blocks",
          "type": "array"
        },
        "role": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.:-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "claim": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClaimPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attribute": {
          "anyOf": [
            {
              "$ref": "#/$defs/Attribute"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "freshness": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldFreshness"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "completeness": {
          "anyOf": [
            {
              "$ref": "#/$defs/Completeness"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sensitivity": {
          "anyOf": [
            {
              "enum": [
                "none",
                "biometric",
                "criminal_record",
                "genetic",
                "health",
                "philosophical_belief",
                "political_opinion",
                "racial_or_ethnic_origin",
                "religion",
                "sexual_life",
                "sexual_orientation",
                "union_membership"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sensitivity"
        },
        "access": {
          "items": {
            "$ref": "#/$defs/AccessRule"
          },
          "maxItems": 20,
          "title": "Access",
          "type": "array"
        },
        "pii": {
          "default": false,
          "title": "Pii",
          "type": "boolean"
        },
        "track_changes": {
          "default": false,
          "title": "Track Changes",
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ],
      "title": "FieldSpec",
      "type": "object"
    },
    "Forbidden": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "From",
          "type": "string"
        },
        "to": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "Forbidden",
      "type": "object"
    },
    "FreshnessClass": {
      "enum": [
        "volatile",
        "price",
        "semi",
        "stable",
        "none"
      ],
      "title": "FreshnessClass",
      "type": "string"
    },
    "Key": {
      "additionalProperties": false,
      "properties": {
        "natural": {
          "description": "Paths of the natural key.",
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Natural",
          "type": "array"
        },
        "fingerprint": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An expression whose value identifies the same observation across sources.",
          "title": "Fingerprint"
        },
        "variant": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant"
        },
        "match": {
          "description": "A pattern per identifier a conversation writes as it is (a case number, an order number), a path of the natural key or a declared field: what the text says in that shape names the customer's own object holding that value, never an object the customer is not tied to.",
          "maxProperties": 8,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            }
          },
          "title": "Match",
          "type": "object"
        }
      },
      "required": [
        "natural"
      ],
      "title": "Key",
      "type": "object"
    },
    "KnownDefect": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Field",
          "type": "string"
        },
        "use_source": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Use Source",
          "type": "string"
        }
      },
      "required": [
        "field",
        "use_source"
      ],
      "title": "KnownDefect",
      "type": "object"
    },
    "Licence": {
      "additionalProperties": false,
      "properties": {
        "commercial_use": {
          "default": "allowed",
          "enum": [
            "allowed",
            "forbidden"
          ],
          "title": "Commercial Use",
          "type": "string"
        },
        "exclude_from_purposes": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Exclude From Purposes",
          "type": "array"
        }
      },
      "title": "Licence",
      "type": "object"
    },
    "Lifecycle": {
      "additionalProperties": false,
      "properties": {
        "transitions": {
          "items": {
            "$ref": "#/$defs/Transition"
          },
          "maxItems": 100,
          "title": "Transitions",
          "type": "array"
        },
        "forbidden": {
          "items": {
            "$ref": "#/$defs/Forbidden"
          },
          "maxItems": 100,
          "title": "Forbidden",
          "type": "array"
        },
        "latches": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Latches",
          "type": "array"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/Outcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Lifecycle",
      "type": "object"
    },
    "MirrorOf": {
      "additionalProperties": false,
      "description": "The company's system this type mirrors: Niadra mirrors and never is the barrier.",
      "properties": {
        "system": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,63}$",
          "title": "System",
          "type": "string"
        },
        "derived_by": {
          "default": "declaration",
          "enum": [
            "declaration",
            "introspection",
            "observation"
          ],
          "title": "Derived By",
          "type": "string"
        },
        "fingerprint": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The fingerprint of the catalog an introspection read.",
          "title": "Fingerprint"
        },
        "drift": {
          "default": "alert",
          "enum": [
            "alert",
            "ignore"
          ],
          "title": "Drift",
          "type": "string"
        }
      },
      "required": [
        "system"
      ],
      "title": "MirrorOf",
      "type": "object"
    },
    "Observer": {
      "additionalProperties": false,
      "properties": {
        "who": {
          "pattern": "^(machine|human|source:[a-z][a-z0-9_]{0,63})$",
          "title": "Who",
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{0,63}@[A-Za-z0-9_.-]{1,32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "validity": {
          "anyOf": [
            {
              "pattern": "^[0-9]{1,6}(ms|s|min|h|d)$",
              "type": "string"
            },
            {
              "const": "never",
              "type": "string"
            }
          ],
          "title": "Validity"
        },
        "overrides": {
          "items": {
            "pattern": "^(machine|human|source:[a-z][a-z0-9_]{0,63})$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Overrides",
          "type": "array"
        }
      },
      "required": [
        "who",
        "validity"
      ],
      "title": "Observer",
      "type": "object"
    },
    "Outcome": {
      "additionalProperties": false,
      "properties": {
        "provisional": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Provisional",
          "type": "array"
        },
        "final": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Final",
          "type": "array"
        },
        "expired_without_outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExpiredWithoutOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "vocabularies": {
          "items": {
            "$ref": "#/$defs/OutcomeVocabulary"
          },
          "maxItems": 10,
          "title": "Vocabularies",
          "type": "array"
        }
      },
      "title": "Outcome",
      "type": "object"
    },
    "OutcomeVocabulary": {
      "additionalProperties": false,
      "properties": {
        "source": {
