          "claim": {
            "allowed": true,
            "class": "money",
            "nature": "computed"
          }
        },
        "health_declaration": {
          "type": "text",
          "sensitivity": "health",
          "pii": true,
          "access": [
            {
              "readers": [
                "agent:closing"
              ],
              "purposes": [
                "closing"
              ],
              "effect": "allow"
            },
            {
              "readers": [
                "agent:sales"
              ],
              "purposes": [
                "sales"
              ],
              "effect": "deny"
            }
          ]
        }
      },
      "sources": {
        "crm": {
          "kind": "push",
          "precedence": 1,
          "authoritative_for": [
            "*"
          ]
        },
        "carrier_portal": {
          "kind": "pull",
          "precedence": 2,
          "cost": "paid"
        }
      },
      "states": [
        "draft",
        "submitted",
        "under_review",
        "approved",
        "rejected",
        "signed",
        "paid",
        "cancelled"
      ],
      "lifecycle": {
        "transitions": [
          {
            "from": "draft",
            "to": "submitted",
            "by": [
              "agent",
              "human"
            ]
          },
          {
            "from": "submitted",
            "to": "under_review",
            "by": [
              "source"
            ]
          },
          {
            "from": "under_review",
            "to": "approved",
            "by": [
              "source"
            ]
          },
          {
            "from": "under_review",
            "to": "rejected",
            "by": [
              "source"
            ]
          },
          {
            "from": "approved",
            "to": "signed",
            "by": [
              "source",
              "human"
            ],
            "evidence": "required"
          },
          {
            "from": "signed",
            "to": "paid",
            "by": [
              "source"
            ],
            "evidence": "required"
          },
          {
            "from": "*",
            "to": "cancelled",
            "by": [
              "source",
              "human"
            ]
          }
        ],
        "forbidden": [
          {
            "from": "paid",
            "to": "draft"
          }
        ],
        "latches": [
          "signed",
          "paid"
        ],
        "outcome": {
          "provisional": [
            "signed"
          ],
          "final": [
            "paid",
            "rejected",
            "cancelled"
          ],
          "expired_without_outcome": {
            "after": "30d"
          },
          "vocabularies": [
            {
              "source": "carrier_portal",
              "map": {
                "APROVADA": "approved",
                "RECUSADA": "rejected"
              },
              "precedence": 1
            }
          ]
        }
      },
      "timers": {
        "follow_up": {
          "due": "submitted_at + 48h",
          "once_per": "proposal",
          "on_fire": [
            "notify"
          ]
        }
      },
      "refetch": {
        "reasons": [
          {
            "name": "under_review",
            "when": "state == 'under_review'",
            "budget": {
              "units": 1,
              "per": "object/6h"
            }
          }
        ],
        "never": [
          "no_news"
        ],
        "budget": {
          "unit": "portal_call",
          "never_money": true,
          "min_interval": "6h"
        }
      },
      "purposes": {
        "claim": {
          "on_stale": "serve_with_prohibitions",
          "prohibitions": [
            "affirm_price",
            "affirm_approval"
          ]
        }
      },
      "retention": {
        "projection": "1825d"
      }
    },
